# Copy to .env for local (non-container) development.
# In Kubernetes these are supplied via ConfigMap/Secret -- see k8s/base/.

# Required. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# "True"/"1"/"yes"/"on" (case-insensitive) enables debug mode. Anything else,
# including unset, is False. (Upstream used os.getenv("DEBUG") directly, so
# DEBUG=False was truthy -- see docs/APP_CHANGES.md.)
DEBUG=False

# Comma-separated. Required when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# PostgreSQL connection (already read from env by upstream settings.py).
DATABASE_NAME=exchange
DATABASE_USER=exchange
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Documented in the upstream README's .env instructions but not read by any
# code path in this app (verified by grep across Exchange/) -- kept here for
# parity with upstream's documented interface, currently inert.
API_KEY=

# --- S3-compatible object storage, used only by scripts/seal-secrets.sh ---
# (CNPG's ObjectStore -- see k8s/base/postgres-objectstore.yaml). Not read by
# the Django app itself.
S3_ENDPOINT=https://s3.example-region.example-provider.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PREFIX=crypto-exchange
# Passed through as the ObjectStore's s3Credentials.region -- most
# S3-compatible providers need *some* value here even if they don't have
# "real" AWS regions; use whatever your provider documents.
S3_REGION=us-east-1
